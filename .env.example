# Copy this file to .env in the project root and fill in your own
# Supabase project's values (Dashboard → Project Settings → API).
# Vite only exposes variables prefixed with VITE_ to the browser.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ------------------------------------------------------------------
# NOTE: M-Pesa/IntaSend credentials are NOT set here. They belong to
# the Edge Functions (server-side only) and are set separately via:
#   supabase secrets set INTASEND_SECRET_KEY=your-key
#   supabase secrets set INTASEND_ENV=sandbox
#   supabase secrets set INTASEND_WEBHOOK_CHALLENGE=some-random-string
# See README's "Monetization / M-Pesa payments" section.
# ------------------------------------------------------------------
